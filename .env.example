# Salesforce Agentforce Configuration
# Copie este arquivo para .env e preencha com os valores reais do seu Embedded Service Deployment

# Obtenha estes valores em: Setup → Embedded Service Deployments → [Seu Deployment] → Get Code

VITE_SALESFORCE_ORG_ID=00Dxx000000abcd
VITE_SALESFORCE_DEPLOYMENT_ID=572xx000000001
VITE_SALESFORCE_BASE_CORE_URL=https://sua-org.my.salesforce.com
VITE_SALESFORCE_SCRT_URL=https://sua-org.my.salesforce-scrt.com
VITE_SALESFORCE_ESW_CONFIG_DEV_NAME=Agentforce_Chat
VITE_SALESFORCE_BASE_LIVE_AGENT_URL=https://d.la2-c1-ia4.salesforceliveagent.com/chat
VITE_SALESFORCE_BASE_LIVE_AGENT_CONTENT_URL=https://c.la2-c1-ia4.salesforceliveagent.com/content
VITE_SALESFORCE_ESW_LIVE_AGENT_DEV_NAME=EmbeddedServiceLiveAgent_Parent04Ixx...

# Customização Visual
VITE_CHAT_BRAND_COLOR=#0066FF
VITE_CHAT_BUTTON_LABEL=Fale com nosso Agente
